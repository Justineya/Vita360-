# OpenAI-compatible API (通义 / DeepSeek / OpenAI 等)
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 本地 / 上线
HOST=127.0.0.1
PORT=8765

# 登录会话（上线请把 HOST 改为 0.0.0.0，并尽量用 HTTPS）
# COOKIE_SECURE=auto   # auto | 1 | 0；auto 在 HTTPS 下自动加 Secure
# SESSION_DAYS=14
# ALLOW_REGISTER=0     # 1 则允许再创建账号（默认只有第一次可创建）
