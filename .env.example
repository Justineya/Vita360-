# OpenAI-compatible API (通义 / DeepSeek / OpenAI 等)
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 本地 / 上线（上线请改 HOST=0.0.0.0）
HOST=127.0.0.1
PORT=8765

# 登录会话（尽量用 HTTPS；COOKIE_SECURE=auto 会在 HTTPS 下自动加 Secure）
# COOKIE_SECURE=auto
# SESSION_DAYS=14
# ALLOW_REGISTER=0

# 启动时自动准备默认账号（跳过「创建账号」）。上线给外人用前请改掉密码。
SEED_ON_START=1
SEED_USERNAME=admin
SEED_PASSWORD=admin
